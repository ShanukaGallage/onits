# ─────────────────────────────────────────────────────────────────────────────
#  OnIts Backend — Environment Variables Template
#  File: backend/.env.example
#
#  INSTRUCTIONS:
#  1. Copy this file: cp .env.example .env
#  2. Fill in your real values in .env
#  3. NEVER commit the .env file (it is in .gitignore)
#  4. Production values are managed via Doppler Cloud Vault
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
#
# IMPORTANT — Two separate URLs are required for Neon + Prisma:
#
# DATABASE_URL → The POOLER connection string (use this for all runtime queries)
#   Format: postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
#   Your pooler host: ep-morning-brook-ao6al83w-pooler.c-2.ap-southeast-1.aws.neon.tech
#
# DIRECT_URL → The DIRECT connection string (used by `prisma migrate` only)
#   Migrations cannot go through the pooler — they need a persistent connection.
#   Format: postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
#   Your direct host: ep-morning-brook-ao6al83w.c-2.ap-southeast-1.aws.neon.tech
#
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-morning-brook-ao6al83w-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-morning-brook-ao6al83w.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT Session ───────────────────────────────────────────────────────────────
# Generate a cryptographically secure secret (run this in your terminal):
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ── CORS (allowed frontend origin) ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Email (Nodemailer via Testmail.app) ───────────────────────────────────────
# Sign up at testmail.app — free tier supports unlimited test addresses
TESTMAIL_NAMESPACE=your-namespace
TESTMAIL_API_KEY=your-testmail-api-key
SMTP_HOST=smtp.testmail.app
SMTP_PORT=587
SMTP_USER=your-namespace.onits@inbox.testmail.app
SMTP_PASS=your-testmail-api-key
