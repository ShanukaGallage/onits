// ─────────────────────────────────────────────────────────────────────────────
//  OnIts — Prisma Schema
//  Database: Neon PostgreSQL (ap-southeast-1 | Singapore)
//  Owner: Shanuka (DB Lead)
//
//  SECURITY LAWS:
//  1. ALL primary keys are UUID strings — integer autoincrement is BANNED (anti-IDOR)
//  2. passwordHash is NEVER included in API responses — use safeUserSelect in db.ts
//  3. Cascade deletes follow the ownership chain: Project → Tasks → Assignments/Comments/etc.
//  4. Two compound indices for query performance: [projectId, status] and [userId, isRead]
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  Admin
  ProjectManager
  Collaborator
}

enum UserStatus {
  Active
  Deactivated
}

enum Priority {
  Low
  Medium
  High
}

enum TaskStatus {
  ToDo
  InProgress
  Completed
}

enum NotificationType {
  TaskAssigned
  StatusChanged
  CommentAdded
  DeadlineApproach
  AdminUpdate
}

enum ChannelType {
  Project
  Thread
}

enum ProjectStatus {
  Planning
  InProgress
  Completed
  Archived
}

// ─────────────────────────────────────────────────────────────────────────────
//  MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  username     String     @unique
  // NEVER expose this field in API responses — always query with safeUserSelect
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  role         Role       @default(Collaborator)
  status       UserStatus @default(Active)
  // Forces password reset on first login — part of admin-created user flow
  isFirstLogin Boolean    @default(true) @map("is_first_login")
  createdAt    DateTime   @default(now()) @map("created_at")
  // @updatedAt: Prisma automatically refreshes this on every record update
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  createdProjects    Project[]        @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  createdTasks       Task[]           @relation("TaskCreator")
  taskAssignments    TaskAssignment[]
  comments           Comment[]
  attachments        Attachment[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  createdChannels    Channel[]        @relation("ChannelCreator")
  sentMessages       Message[]        @relation("MessageSender")

  @@map("users")
}

model Project {
  id                      String        @id @default(uuid())
  projectKey              String        @unique @map("project_key")
  name                    String
  description             String?
  visibility              String        @default("PUBLIC")
  status                  ProjectStatus @default(Planning)
  colorCode               String?       @map("color_code")
  tags                    String[]      @default([])
  estimatedCompletionDate DateTime?     @map("estimated_completion_date")
  externalLinks           String[]      @default([]) @map("external_links")
  createdById             String        @map("created_by")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  // Relations
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  tasks       Task[]
  channels    Channel[]
  attachments Attachment[]

  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Cascade: deleting a Project removes all its memberships
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Cascade: deleting a User removes them from all projects
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite PK — no duplicate memberships, no unnecessary ID column
  @@id([projectId, userId])
  @@map("project_members")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?  @map("due_date")
  priority    Priority   @default(Medium)
  status      TaskStatus @default(ToDo)
  createdById String     @map("created_by")
  projectId   String     @map("project_id")
  tags        String[]   @default([])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  createdBy     User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  // Cascade: deleting a Project wipes all its Tasks (and their children below)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments   TaskAssignment[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]

  // PERFORMANCE INDEX: Kanban board queries filter by project then group by status
  // Without this, every board render does a full table scan
  @@index([projectId, status])
  @@map("tasks")
}

model TaskAssignment {
  taskId     String   @map("task_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  // Cascade: deleting a Task removes all its assignments
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Cascade: deleting a User removes all their task assignments
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignments")
}

model Comment {
  id          String   @id @default(uuid())
  content     String
  taskId      String   @map("task_id")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Cascade: deleting a Task wipes all its Comments
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Attachment {
  id           String   @id @default(uuid())
  fileName     String   @map("file_name")
  // URL to cloud storage (e.g. Azure Blob Storage or a local /uploads path)
  fileUrl      String   @map("file_url")
  // Size in bytes — Int supports up to ~2.1GB which is sufficient for attachments
  fileSize     Int      @map("file_size")
  fileType     String   @map("file_type")
  taskId       String?  @map("task_id")
  projectId    String?  @map("project_id")
  uploadedById String   @map("uploaded_by")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  // Relations
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  userId    String           @map("user_id")
  // Nullable: some admin notifications are not linked to a specific task
  taskId    String?          @map("task_id")
  createdAt DateTime         @default(now()) @map("created_at")

  // Cascade: deleting a User removes all their notifications
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull: deleting a Task nullifies the taskId on notifications (keeps notification history)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // PERFORMANCE INDEX: Notification panel queries filter by user then group by read status
  // This index is what makes the unread count badge query fast
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
//  RefreshToken — issued on login, rotated on every /auth/refresh call
//  tokenHash: bcrypt hash of the raw token — raw value never persisted
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  // bcrypt hash of the raw refresh token — the raw value is only held in memory
  tokenHash String   @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Cascade: deleting a User removes all their refresh tokens
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fast lookup: find all tokens for a user on login/logout/rotation
  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Channels & Messages — Inbox
// ─────────────────────────────────────────────────────────────────────────────

model Channel {
  id          String      @id @default(uuid())
  name        String
  type        ChannelType
  projectId   String?     @map("project_id")
  createdById String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("channels")
}

model Message {
  id        String   @id @default(uuid())
  content   String
  channelId String   @map("channel_id")
  senderId  String   @map("sender_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@map("messages")
}
